# Copia a .env (install.sh lo hace por ti y no sobrescribe valores existentes).
# Imagen publicada por GitHub Actions (multi-arch amd64 + arm64).
PROGRESSIUM_IMAGE=ghcr.io/kyostenas/progressium
PROGRESSIUM_TAG=latest
# La PWA y la API se sirven desde el mismo origen: CORS cerrado. Solo para desarrollo
# (p. ej. http://localhost:4200) pon orígenes extra separados por coma; vacío = ninguno.
PROGRESSIUM_ORIGINS=
# Dónde escucha en el host. Deja 127.0.0.1 y publica con Tailscale Funnel / Cloudflare Tunnel.
PROGRESSIUM_BIND=127.0.0.1
PROGRESSIUM_PORT=8090
PROGRESSIUM_MEM=256m
PROGRESSIUM_GOMEMLIMIT=200MiB
PROGRESSIUM_GOMAXPROCS=2
# Usuario del contenedor. install.sh pone 0:0 solo si el kernel (Android) impide sockets a uids sin privilegios.
PROGRESSIUM_USER=
TZ=America/Mexico_City
# Cifra los ajustes de PocketBase (32 caracteres). install.sh la genera; no la pierdas.
PB_ENCRYPTION_KEY=
# Secreto para sales falsas de GET /cuenta/sales (HMAC del alias). install.sh lo genera.
PROGRESSIUM_SALES_SECRET=
# Correo del superusuario del panel (/_/). La contraseña se genera y se guarda en secretos/admin.txt.
PB_ADMIN_EMAIL=admin@progressium.local
# Respaldos: carpeta del host, cuántos guardar y (opcional) destinatario age para cifrarlos.
RESPALDO_DIR=./respaldos
RESPALDO_MANTENER=7
RESPALDO_AGE_RECIPIENT=
# Tailscale Funnel (opcional): nodo propio con URL https://progressium.<tailnet>.ts.net
# Pega aquí una auth key (reusable=no, preautorizada, con tag que tenga permiso de Funnel). Tras el
# primer arranque el nodo queda guardado en el volumen y puedes borrar la key de este archivo.
TS_AUTHKEY=
TS_HOSTNAME=progressium
TS_EXTRA_ARGS=
