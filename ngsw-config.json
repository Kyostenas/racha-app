{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/media/**"
        ]
      }
    },
    {
      "name": "catalogo-motor",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/data/alimentos.json",
          "/data/ejercicios.json",
          "/data/recetas.json",
          "/data/tokens.json"
        ]
      }
    }
  ]
}
